<?xml version="1.0" encoding="utf-8"?>
<!-- ClockWidget: resizable, about 3×2 cells. No updatePeriodMillis: TextClock ticks on its own and the
     provider redraws on alarm, time zone, language and radio changes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_clock"
    android:minWidth="180dp"
    android:minHeight="120dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="120dp"
    android:previewLayout="@layout/widget_clock"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
