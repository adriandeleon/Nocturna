# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.xml]
indent_size = 4

[*.{json,yml,yaml,md,toml}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.properties]
indent_size = 4

# Generated by Gradle; left exactly as the wrapper task writes them.
[{gradlew,gradlew.bat}]
trim_trailing_whitespace = false
insert_final_newline = false
